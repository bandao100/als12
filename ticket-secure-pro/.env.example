# Copier ce fichier en .env puis remplacer TOUTES les valeurs. Ne jamais versionner .env.
# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(48))"

# Domaine public (le DNS doit pointer vers le serveur ; ports 80 et 443 ouverts)
DOMAIN=billets.exemple.com
ACME_EMAIL=technique@exemple.com

POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-long-et-aleatoire
SECRET_KEY=remplacer-par-48-caracteres-aleatoires-minimum
# Sert à dériver les QR codes : le changer invalide TOUS les billets émis.
TICKET_SECRET=remplacer-par-48-autres-caracteres-aleatoires

# Super administrateur créé au premier démarrage (16 caractères minimum, à changer à la 1re connexion)
PLATFORM_ADMIN_EMAIL=admin@exemple.com
PLATFORM_ADMIN_PASSWORD=remplacer-par-16-caracteres-minimum

# Sites autorisés à intégrer la billetterie de TOUTE la plateforme (widget), séparés par des virgules.
# Chaque organisateur peut aussi déclarer ses propres sites dans son espace (menu Intégration).
EMBED_ORIGINS=

PLATFORM_NAME=Ticket Secure Pro
PLATFORM_FEE_PERCENT=5
APP_TIMEZONE=Africa/Ouagadougou
CURRENCY=XOF

# --- Wave (https://business.wave.com → Développeurs) ---------------------------------------
# Webhook à déclarer : https://DOMAIN/webhooks/wave (événements checkout.session.*)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# --- Orange Money Web Payment (https://developer.orange.com) ---------------------------------
# ORANGE_COUNTRY : « dev » pour le bac à sable, sinon le code pays fourni par Orange (ex. sn, ci, ml).
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_COUNTRY=dev
ORANGE_CURRENCY=

# --- Cartes bancaires via Stripe Checkout ------------------------------------------------------
# Webhook à déclarer : https://DOMAIN/webhooks/stripe (checkout.session.completed, async_payment_*, expired)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-mail d'envoi des billets (SMTP) ----------------------------------------------------------
MAIL_SERVER=smtp.exemple.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_FROM=Ticket Secure Pro <billets@exemple.com>

# --- Sauvegardes ----------------------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
