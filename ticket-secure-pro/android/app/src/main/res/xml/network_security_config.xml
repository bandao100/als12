<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS obligatoire : aucun trafic en clair, seules les autorités système sont reconnues. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
